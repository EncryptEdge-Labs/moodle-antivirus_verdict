{{!
    @template antivirus_verdict/product_start

    Opens the scoped Verdict product shell. Values are escaped by Mustache.

    Example context (json):
    {
        "brandiconurl": "/theme/image.php/boost/antivirus_verdict/1/icon-dark-mode",
        "brandiconlighturl": "/theme/image.php/boost/antivirus_verdict/1/icon-light-mode",
        "brand": "Verdict",
        "navmonitor": "Monitor",
        "navact": "Act",
        "navtoggle": "Open menu",
        "crumbnav": "Breadcrumb",
        "crumbhome": "Home",
        "crumb": "Overview",
        "poweredby": "Powered by EncryptEdge Labs",
        "themetoggle": "Colour mode",
        "themetolight": "Switch to light mode",
        "themetodark": "Switch to dark mode",
        "hastestconnection": true,
        "testconnectionurl": "/lib/antivirus/verdict/test_connection.php",
        "testconnectionlabel": "Test connection",
        "hasscanaction": true,
        "scanurl": "/lib/antivirus/verdict/scan.php",
        "scanlabel": "Scan a file",
        "monitoritems": [{"url": "/lib/antivirus/verdict/index.php", "label": "Overview", "selected": true, "iconoverview": true}],
        "actitems": [{"url": "/lib/antivirus/verdict/scan.php", "label": "Scan a file", "selected": false, "iconscan": true}]
    }
}}
<div class="antivirus-verdict" data-theme="dark">
    <input type="checkbox" id="antivirus-verdict-navtoggle" class="antivirus-verdict-navtoggle" aria-label="{{navtoggle}}" aria-controls="antivirus-verdict-sidebar" aria-expanded="false" />
    <label for="antivirus-verdict-navtoggle" class="antivirus-verdict-navbackdrop">
        <span class="visually-hidden">{{navtoggle}}</span>
    </label>
    <div class="antivirus-verdict-mobilebar">
        <label for="antivirus-verdict-navtoggle" class="antivirus-verdict-menubtn" aria-controls="antivirus-verdict-sidebar" aria-expanded="false">
            <span class="visually-hidden">{{navtoggle}}</span>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <path d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
        </label>
        <span class="antivirus-verdict-brand-slot antivirus-verdict-brand-slot--mobile" aria-hidden="true">
            <img class="antivirus-verdict-mobileicon antivirus-verdict-logo-dark" src="{{brandiconurl}}" alt="" />
            <img class="antivirus-verdict-mobileicon antivirus-verdict-logo-light" src="{{brandiconlighturl}}" alt="" />
        </span>
        <strong class="antivirus-verdict-mobilebrand">{{brand}}</strong>
    </div>
    <div class="antivirus-verdict-shell antivirus-verdict__shell">
        <aside class="antivirus-verdict-sidebar antivirus-verdict__sidebar" id="antivirus-verdict-sidebar" aria-label="{{brand}}">
            <div class="antivirus-verdict-brand">
                <span class="antivirus-verdict-brand-slot" aria-hidden="true">
                    <img class="antivirus-verdict-brand-mark antivirus-verdict-logo-dark" src="{{brandiconurl}}" alt="" />
                    <img class="antivirus-verdict-brand-mark antivirus-verdict-logo-light" src="{{brandiconlighturl}}" alt="" />
                </span>
                <div class="antivirus-verdict-brand-text">
                    <div class="antivirus-verdict-brand-org">{{brand}}</div>
                </div>
            </div>
            <nav class="antivirus-verdict-nav">
                {{#hasmonitoritems}}
                <div class="antivirus-verdict-nav-label">{{navmonitor}}</div>
                {{#monitoritems}}
                    <a class="antivirus-verdict-nav-item{{#selected}} is-active{{/selected}}" href="{{url}}"{{#selected}} aria-current="page"{{/selected}}>
                        {{#iconoverview}}
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                                <circle cx="12" cy="12" r="9"/>
                                <circle cx="12" cy="12" r="3.2"/>
                                <path d="M12 3v3M12 18v3M3 12h3M18 12h3"/>
                            </svg>
                        {{/iconoverview}}
                        {{#iconhistory}}
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                                <circle cx="12" cy="12" r="9"/>
                                <path d="M12 7v5l3.5 2"/>
                            </svg>
                        {{/iconhistory}}
                        {{#iconcoverage}}
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                                <path d="M4 6h16v12H4z"/>
                                <path d="M8 10h8M8 14h5"/>
                            </svg>
                        {{/iconcoverage}}
                        {{#iconquarantine}}
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                                <path d="M5 8h14v11H5z"/>
                                <path d="M9 8V6a3 3 0 0 1 6 0v2"/>
                            </svg>
                        {{/iconquarantine}}
                        {{label}}
                    </a>
                {{/monitoritems}}
                {{/hasmonitoritems}}
                {{#hasactitems}}
                <div class="antivirus-verdict-nav-label">{{navact}}</div>
                {{#actitems}}
                    <a class="antivirus-verdict-nav-item{{#selected}} is-active{{/selected}}" href="{{url}}"{{#selected}} aria-current="page"{{/selected}}>
                        {{#iconscan}}
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                                <path d="M12 4v11M7 10l5 5 5-5"/>
                                <path d="M5 20h14"/>
                            </svg>
                        {{/iconscan}}
                        {{#iconbulk}}
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                                <path d="M4 7h16M4 12h10M4 17h7"/>
                                <circle cx="18" cy="12" r="3"/>
                            </svg>
                        {{/iconbulk}}
                        {{#iconsettings}}
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                                <path d="M4 7h9M17 7h3M4 12h3M9 12h11M4 17h13M19 17h1"/>
                                <circle cx="15" cy="7" r="2"/>
                                <circle cx="7" cy="12" r="2"/>
                                <circle cx="17" cy="17" r="2"/>
                            </svg>
                        {{/iconsettings}}
                        {{label}}
                    </a>
                {{/actitems}}
                {{/hasactitems}}
            </nav>
            <div class="antivirus-verdict-sidebar-foot">
                <div class="antivirus-verdict-version">
                    <span class="antivirus-verdict-pulse{{^scannerlive}} is-paused{{/scannerlive}}" aria-hidden="true"></span>
                    {{poweredby}}
                </div>
            </div>
        </aside>
        <div class="antivirus-verdict-content antivirus-verdict__main">
            <div class="antivirus-verdict-topbar">
                <nav class="antivirus-verdict-crumb" aria-label="{{crumbnav}}">
                    <span>{{crumbhome}}</span>
                    <span class="antivirus-verdict-crumb-sep">/</span>
                    <span class="antivirus-verdict-crumb-current">{{crumb}}</span>
                </nav>
                <div class="antivirus-verdict-topbar-right">
                    <button
                        type="button"
                        class="antivirus-verdict-theme-toggle"
                        data-antivirus-verdict="theme-toggle"
                        data-label-light="{{themetolight}}"
                        data-label-dark="{{themetodark}}"
                        aria-pressed="false"
                        aria-label="{{themetolight}}"
                        title="{{themetolight}}"
                    >
                        <span class="visually-hidden">{{themetoggle}}</span>
                        <svg class="antivirus-verdict-theme-icon antivirus-verdict-theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                            <circle cx="12" cy="12" r="4"/>
                            <path d="M12 3v2M12 19v2M5 12H3M21 12h-2M6.2 6.2l1.4 1.4M16.4 16.4l1.4 1.4M6.2 17.8l1.4-1.4M16.4 7.6l1.4-1.4"/>
                        </svg>
                        <svg class="antivirus-verdict-theme-icon antivirus-verdict-theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                            <path d="M18 13.5A6.5 6.5 0 1 1 10.5 6 5.2 5.2 0 0 0 18 13.5z"/>
                        </svg>
                    </button>
                    {{#hasscanaction}}
                        <a class="antivirus-verdict-topbar-scan" href="{{scanurl}}">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M12 3v12"/>
                                <path d="m7 10 5 5 5-5"/>
                                <path d="M5 21h14"/>
                            </svg>
                            {{scanlabel}}
                        </a>
                    {{/hasscanaction}}
                </div>
            </div>
            <div class="antivirus-verdict-main">

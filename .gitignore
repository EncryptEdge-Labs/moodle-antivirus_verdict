# Archives except committed fixtures (ZIP and Moodle backups)
*.zip
!tests/fixtures/**/*.zip
*.mbz
!tests/fixtures/**/*.mbz
*.log
phpunit*.txt
phpcs*.txt
phpunit-last-run.txt

# Local QA artefacts (keep docs/ in git for reviewers)
/qa-logs/
/dist/

# Live VT ledger if PHPUnit cache is unavailable
